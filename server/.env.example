# ================================================
# VARIABLES DE ENTORNO -- Gestion Restaurante SaaS
# ================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitas el archivo .env al repositorio.

# ----------------------------------------
# SEGURIDAD (OBLIGATORIAS -- el servidor no arranca sin estas)
# ----------------------------------------

# Clave secreta para firmar/verificar JWT tokens.
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# API Key para autenticacion del superadmin y del Sunat Hub.
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SAAS_API_KEY=

# ----------------------------------------
# CONFIGURACION DEL SERVIDOR
# ----------------------------------------
PORT=3003
RESTAURANT_NAME=

# ----------------------------------------
# BASE DE DATOS
# ----------------------------------------
# DATABASE_URL=./database.sqlite
